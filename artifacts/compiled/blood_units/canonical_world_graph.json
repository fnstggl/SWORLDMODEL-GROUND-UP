      "name": "Collection on Friday 24 July",
      "why_safe": "The deadline is Friday noon. The collection drive opens at 9 AM, but any units collected Friday would not be shipped until the next scheduled shipment (Tuesday or Thursday), so they cannot be received by Friday noon."
    },
    {
      "basis": "verified",
      "evidence_ids": [
        "e10"
      ],
      "name": "Elena Cruz",
      "why_safe": "Elena Cruz oversees receipts but does not control collection rate or shipping schedule; her actions do not affect the number of units received."
    },
    {
      "basis": "question_given",
      "evidence_ids": [],
      "name": "Hospital usage or wastage",
      "why_safe": "The question asks for 'received' units, not net stock. Usage or wastage does not change the number of units received."
    },
    {
      "basis": "verified",
      "evidence_ids": [
        "e7"
      ],
      "name": "Other hospitals or blood centres",
      "why_safe": "The question only concerns St. Vincent regional hospital's received units. Other entities do not affect this hospital's stock unless they receive shipments from the same centre, but the centre's shipments are dedicated to St. Vincent per the distribution agreement."
    }
