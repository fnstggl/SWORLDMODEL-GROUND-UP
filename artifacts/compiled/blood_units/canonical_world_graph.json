      ],
      "name": "Other hospitals or blood centres",
      "why_safe": "The question only concerns St. Vincent regional hospital's receipts from Cascade regional blood centre. No other sources or destinations are mentioned."
    },
    {
      "basis": "verified",
      "evidence_ids": [
        "e3",
        "e4"
      ],
      "name": "Weekend collections",
      "why_safe": "The drive is only open Monday to Friday, and the deadline is Friday noon, so weekend collections are irrelevant."
    }
