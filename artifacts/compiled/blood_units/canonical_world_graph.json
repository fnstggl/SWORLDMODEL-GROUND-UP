    {
      "basis": "inferred",
      "evidence_ids": [
        "e6"
      ],
      "name": "Blood usage at the hospital",
      "why_safe": "The question asks for units 'received' by Friday noon, not the net inventory after usage. Usage does not affect the count of received units."
    },
    {
      "basis": "inferred",
      "evidence_ids": [
        "e3",
        "e7"
      ],
      "name": "Friday collection",
      "why_safe": "The deadline is Friday noon. The drive opens at 9:00 AM Friday, but any units collected after the deadline are not received by the hospital by Friday noon. Also, shipments only occur Tuesday and Thursday, so Friday collection cannot be shipped before the deadline."
    },
    {
      "basis": "verified",
      "evidence_ids": [
        "e8"
      ],
      "name": "Other courier services or delays",
      "why_safe": "The evidence specifies a single courier service with a 3-hour transit time. No alternative services or delays are mentioned, so we assume the standard service."
    },
    {
      "basis": "inferred",
      "evidence_ids": [
        "e7"
      ],
      "name": "Other hospitals or blood centres",
      "why_safe": "The question only concerns St. Vincent regional hospital's received units. Other entities do not affect the hospital's inventory unless they receive shipments meant for it, but the distribution agreement specifies shipments only to St. Vincent. No evidence suggests sharing or transfers."
    },
    {
      "basis": "verified",
      "evidence_ids": [
        "e3",
        "e4"
      ],
      "name": "Weekend collections (Saturday/Sunday)",
      "why_safe": "The drive is only open Monday to Friday, so no weekend collections occur during the week in question."
    }
  ],
