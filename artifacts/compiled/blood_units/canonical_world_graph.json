    {
      "basis": "inferred",
      "evidence_ids": [
        "e3",
        "e4",
        "e7"
      ],
      "name": "Friday collection",
      "why_safe": "The deadline is Friday noon, and the drive opens at 9:00 AM Friday. However, any units collected on Friday would not be shipped until the next scheduled shipment (Tuesday or Thursday), so they cannot be received by Friday noon. Thus excluding Friday collection is safe."
    },
    {
      "basis": "verified",
      "evidence_ids": [
        "e1",
