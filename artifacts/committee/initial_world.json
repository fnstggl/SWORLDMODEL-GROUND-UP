{
  "action_defs": {
    "cast_vote": {
      "conditions": [
        {
          "key": "meeting_open",
          "require": "fact_equals",
          "value": true
        },
        {
          "require": "role_in",
          "roles": [
            "chair",
            "member"
          ]
        },
        {
          "key": "motion",
          "require": "fact_equals",
          "value": "{params.motion}"
        },
        {
          "key": "vote:{actor}",
          "require": "fact_absent"
        },
        {
          "param": "choice",
          "require": "param_in",
          "values": [
            "hold",
            "cut"
          ]
        }
      ],
      "description": "Cast your vote on the motion on the floor (members only, meeting in session, one vote each). params: motion, choice (hold|cut).",
      "effects": [
        [
          "fact.set",
          {
            "key": "vote:{actor}",
            "value": "{params.choice}"
          }
        ],
        [
          "actor.memory",
          {
            "actor": "{actor}",
            "content": "Voted {params.choice} on: {params.motion}",
            "kind": "note",
            "source": "{action_id}"
          }
        ]
      ],
      "verb": "cast_vote"
    },
    "prepare_briefing": {
      "conditions": [
        {
          "require": "role_in",
          "roles": [
            "staff analyst"
          ]
        },
        {
          "info": "{params.based_on_info}",
          "require": "noticed_info"
        },
        {
          "param": "content",
          "require": "param_nonempty"
        }
      ],
      "description": "Prepare a staff briefing from a noticed release and email it to the committee. params: based_on_info, content.",
      "effects": [
        [
          "info.send_new",
          {
            "author": "{actor}",
            "channel": "email",
            "content": "{params.content}",
            "data": {
              "based_on": "{params.based_on_info}",
              "type": "briefing"
            },
            "to": {
              "role_in": [
                "chair",
                "member"
              ]
            }
          }
        ],
        [
          "actor.memory",
          {
            "actor": "{actor}",
            "content": "Sent the inflation briefing to the committee.",
            "kind": "note",
            "source": "{action_id}"
          }
        ]
      ],
      "verb": "prepare_briefing"
    },
    "propose_motion": {
      "conditions": [
        {
          "key": "meeting_open",
          "require": "fact_equals",
          "value": true
        },
        {
          "require": "role_in",
          "roles": [
            "chair"
          ]
        },
        {
          "key": "motion",
          "require": "fact_absent"
        },
        {
          "param": "motion",
          "require": "param_nonempty"
        }
      ],
      "description": "Put a motion on the floor (chair only, meeting in session). params: motion.",
      "effects": [
        [
          "fact.set",
          {
            "key": "motion",
            "value": "{params.motion}"
          }
        ],
        [
          "info.send_new",
          {
            "author": "{actor}",
            "channel": "meeting_floor",
            "content": "Motion on the floor: {params.motion}. Please vote.",
            "data": {
              "motion": "{params.motion}",
              "type": "motion"
            },
            "to": {
              "exclude": [
                "{actor}"
              ],
              "role_in": [
                "chair",
                "member"
              ]
            }
          }
        ],
        [
          "actor.memory",
          {
            "actor": "{actor}",
            "content": "Put the motion on the floor: {params.motion}",
            "kind": "note",
            "source": "{action_id}"
          }
        ]
      ],
      "verb": "propose_motion"
    },
    "read_message": {
      "conditions": [
        {
          "info": "{params.info}",
          "require": "noticed_info"
        }
      ],
      "description": "Read a message you have noticed. params: info (message id), content (the text, for your own record). Reading takes time.",
      "effects": [
        [
          "actor.memory",
          {
            "actor": "{actor}",
            "content": "Read message {params.info} in full.",
            "kind": "note",
            "source": "{params.info}"
          }
        ]
      ],
      "verb": "read_message"
    },
    "send_message": {
      "conditions": [
        {
          "id": "{params.to}",
          "require": "actor_exists"
        },
        {
          "name": "{params.channel}",
          "require": "channel_exists"
        },
        {
          "param": "content",
          "require": "param_nonempty"
        }
      ],
      "description": "Compose and send a message. params: to (actor id), channel, content, data (optional dict). Composing takes time; delivery latency comes from the channel.",
      "effects": [
        [
          "info.send_new",
          {
            "author": "{actor}",
            "channel": "{params.channel}",
            "content": "{params.content}",
            "data": "{params.data}",
            "to": [
              "{params.to}"
            ]
          }
        ],
        [
          "actor.memory",
          {
            "actor": "{actor}",
            "content": "Sent message to {params.to} on {params.channel}: {params.content}",
            "kind": "note",
            "source": "{action_id}"
          }
        ]
      ],
      "verb": "send_message"
    }
  },
