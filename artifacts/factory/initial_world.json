{
  "action_defs": {
    "fulfill_order": {
      "conditions": [
        {
          "require": "role_in",
          "roles": [
            "ops manager"
          ]
        },
        {
          "key": "order:{params.order_id}:status",
          "require": "fact_equals",
          "value": "received"
        }
      ],
      "description": "Commit to fulfill an open order: stage stock and ship as soon as inventory covers it. params: order_id, qty. Completes when factory inventory reaches qty.",
      "effects": [
        [
          "fact.set",
          {
            "key": "order:{params.order_id}:status",
            "value": "shipped"
          }
        ],
        [
          "resource.transfer",
          {
            "amount": "{params.qty}",
            "from_holder": "factory",
            "name": "widgets",
            "to_holder": "carrier"
          }
        ],
        [
          "event.schedule_in",
          {
            "basis": "inferred",
            "data": {
              "note": "carrier delivers PO {params.order_id}",
              "ops": [
                [
                  "resource.transfer",
                  {
                    "amount": "{params.qty}",
                    "from_holder": "carrier",
                    "name": "widgets",
                    "to_holder": "acme"
                  }
                ],
                [
                  "fact.set",
                  {
                    "key": "order:{params.order_id}:status",
                    "value": "delivered"
                  }
                ],
                [
                  "info.send_new",
                  {
                    "author": "carrier",
                    "channel": "order_system",
                    "content": "Delivery confirmation: PO {params.order_id} ({params.qty} widgets) delivered.",
                    "data": {
                      "id": "{params.order_id}",
                      "type": "delivery"
                    },
                    "to": [
                      "mo",
                      "acme_contact"
                    ]
                  }
                ]
              ]
            },
            "delay_hours": 18,
            "kind": "world.ops",
            "note": "regional freight transit time, comparable lanes"
          }
        ],
        [
          "actor.memory",
          {
            "actor": "{actor}",
            "content": "Shipped PO {params.order_id}: {params.qty} widgets handed to the carrier.",
            "kind": "note",
            "source": "{action_id}"
          }
        ]
      ],
      "verb": "fulfill_order"
    }
  },
