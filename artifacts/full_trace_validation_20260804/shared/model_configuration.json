{
  "provider": "deepseek",
  "base_url": "https://api.deepseek.com",
  "model": "deepseek-chat",
  "roles": {
    "compiler": {
      "transport": "compiler.scene_llm.SceneCaller(transport=)",
      "temperature": 0.0,
      "max_tokens": 8000,
      "response_format": "json_object",
      "semantic_call_budget": 3
    },
    "candidate_generator": {
      "seam": "decision_route.prepare_decision_inputs(generator_model=)",
      "temperature": 0.0,
      "max_tokens": 2000,
      "response_format": "json_object",
      "calls_per_generation": 1
    },
    "actor": {
      "seam": "counterfactuals.manager.run_candidates_detailed(model_factory=)",
      "temperature": 0.0,
      "max_tokens": 400,
      "response_format": null
    },
    "game_master": {
      "seam": "counterfactuals.manager.run_candidates_detailed(model_factory=)",
      "temperature": 0.0,
      "max_tokens": 400,
      "response_format": null
    }
  },
  "retry_policy": {
    "max_attempts_per_call": 4,
    "backoff_seconds": [
      2.0,
      6.0,
      15.0
    ],
    "every_attempt_recorded": true
  },
  "sampling_note": "temperature 0 is a bounded policy, not a determinism claim: the provider does not guarantee reproducible completions"
}
