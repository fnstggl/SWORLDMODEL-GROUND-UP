__pycache__/
*.pyc
.pytest_cache/

# Generated evaluation runs.  These are EVIDENCE, not source.
#
# PR #5 added more than a thousand of them to the production diff, which
# made the change unreviewable and told a reader nothing they could not
# regenerate.  Compact machine-generated summaries live in
# artifacts/history/ and artifacts/final_v6/SUMMARY.txt; the evaluator
# scripts that produce them are under evaluation/; and every deleted tree
# remains in git history at the commit that produced it.
artifacts/simulations_v*/
artifacts/scene_acceptance/
artifacts/matched_pairs/*/actor_*.jsonl
artifacts/matched_pairs/*/world_*.jsonl
artifacts/matched_pairs/*/review_*.jsonl
artifacts/matched_pairs/*/*.md
artifacts/baseline_main/*/
artifacts/final_v*/*/
# A corpus run's whole directory, summary included.  The summary used to
# be tracked in place, so deleting the tree to re-run left the working
# tree dirty for the hour the new run took -- and a half-finished
# summary is not evidence of anything.  A FINISHED run's summary is
# copied to artifacts/semantic_runtime/mvp/, which is where the report
# cites it from.
artifacts/mvp_v*/
artifacts/*_run.log
